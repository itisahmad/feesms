# Django Settings (local + Vercel)
DJANGO_SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Vercel backend — required environment variables (Project Settings → Environment Variables):
#   DJANGO_SECRET_KEY
#   DATABASE_URL          (Neon/Postgres connection string — required, app crashes without it)
#   DJANGO_SETTINGS_MODULE=config.settings_production
#   CORS_ALLOWED_ORIGINS=https://feesms-frontend.vercel.app
# Optional: EMAIL_*, MAINTENANCE_MODE, MAINTENANCE_MESSAGE

# CORS Settings
CORS_ALLOWED_ORIGINS=https://feesms-frontend.vercel.app,http://localhost:3000
